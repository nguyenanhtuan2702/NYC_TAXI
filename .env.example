# Sao chép thành .env nếu muốn đổi giá trị mặc định (không bắt buộc).
# Đường dẫn bên trong container Mage; repo được mount tại /home/src.
DUCKDB_PATH=/home/src/data/warehouse/nyc_taxi.duckdb
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
DUCKDB_TEMP_DIR=/home/src/data/warehouse/tmp
RAW_DATA_DIR=/home/src/data/raw
# Cảnh báo khi pipeline nyc_taxi_e2e lỗi (incoming webhook Slack/Discord/Teams). Để trống = chỉ ghi file.
ALERT_WEBHOOK_URL=
